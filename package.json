{
  "name": "react-auto-i18ner",
  "version": "2.0.0",
  "description": "AST-based React i18n automation: extract UI text, wrap it in t(), inject the translation hook, and generate nested locale files. Supports react-i18next and next-intl, with an optional AI-agent layer for semantic keys and translations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "react-auto-i18ner": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "i18n",
    "internationalization",
    "localization",
    "automation",
    "jsx",
    "typescript",
    "ast",
    "babel",
    "codemod",
    "transform",
    "extract",
    "translation",
    "react-i18next",
    "next-intl",
    "cli"
  ],
  "author": "Hamza Islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/starhax4/react-auto-i18ner.git"
  },
  "bugs": {
    "url": "https://github.com/starhax4/react-auto-i18ner/issues"
  },
  "homepage": "https://github.com/starhax4/react-auto-i18ner#readme",
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.1.0",
    "inquirer": "^8.2.0",
    "recast": "^0.23.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-i18next": ">=11.0.0",
    "i18next": ">=20.0.0",
    "next-intl": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-i18next": { "optional": true },
    "i18next": { "optional": true },
    "next-intl": { "optional": true }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
